alert tcp 192.168.50.128 any -> 192.168.50.131 any (msg:"LOCAL Nmap SYN Scan Detected"; flags:S; flow:stateless; detection_filter:track by_src, count 5, seconds 10; sid:1000002; rev:2;)

alert tcp 192.168.50.128 any -> 192.168.50.131 22 (msg:"LOCAL Repeated SSH Connection from Kali"; flags:S; flow:to_server,stateless; detection_filter:track by_src, count 2, seconds 30; sid:1000003; rev:3;)

alert http 192.168.50.128 any -> 192.168.50.131 80 (msg:"LOCAL Possible SQL Injection Boolean Pattern"; flow:to_server,established; http.uri; pcre:"/(?:%27|')?\s*(?:or|and)\s+(?:%27|')?\d+(?:%27|')?\s*=\s*(?:%27|')?/Ui"; sid:1000004; rev:3;)